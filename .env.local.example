# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in every value before running the app.
# .env.local is gitignored. This file MUST be kept in sync with src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# The public URL of your deployment (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk (https://dashboard.clerk.com) ──────────────────────────────────────
# Publishable key starts with pk_test_ or pk_live_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret key starts with sk_test_ or sk_live_
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret — create a webhook endpoint in Clerk dashboard pointing
# to /api/auth and copy the Signing Secret here
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase (https://supabase.com/dashboard) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service-role key has full DB access — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CDN base URL for storage (found in Storage settings)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# ── Database / Prisma ────────────────────────────────────────────────────────
# Use the pooled connection for runtime queries (port 6543 in Supabase)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-xx-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use the direct connection for migrations — bypasses pgBouncer (port 5432)
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-xx-east-1.pooler.supabase.com:5432/postgres

# ── Stripe (https://dashboard.stripe.com) ────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret — create a webhook in Stripe pointing to /api/billing
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Price IDs for the Pro plan — create products/prices in the Stripe dashboard
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Upstash Redis (https://console.upstash.com) ───────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (https://resend.com/api-keys) ──────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry (https://sentry.io) ───────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx
# Optional: only needed for uploading source maps during CI builds
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
